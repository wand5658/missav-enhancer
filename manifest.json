{
  "manifest_version": 3,
  "name": "Video Helper - Anti Auto-Pause & Wide Layout",
  "short_name": "Video Helper",
  "version": "1.0",
  "description": "Stops the page from auto-pausing playback when the window or tab loses focus, and widens the video layout.",
  "host_permissions": [
    "https://missav.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://missav.ai/*"
      ],
      "js": [
        "anti-pause.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://missav.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}