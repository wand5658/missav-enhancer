{
  "manifest_version": 3,
  "name": "Video Helper - Anti Auto-Pause & Wide Layout",
  "short_name": "Video Helper",
  "version": "1.2",
  "description": "Stops the page from auto-pausing playback when the window or tab loses focus, widens the video layout, and adds a cover carousel to the home page.",
  "host_permissions": [
    "https://missav.ai/*",
	"https://missav.ws/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://missav.ai/*",
		"https://missav.ws/*"
      ],
      "js": [
        "anti-pause.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://missav.ai/*",
		"https://missav.ws/*"
      ],
      "js": [
        "content.js",
        "hero.js"
      ],
      "run_at": "document_end"
    }
  ]
}